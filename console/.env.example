# Bengaluru Pulse - console env (copy to .env). Vite inlines VITE_* at build time.
# Only PUBLIC values belong here - the anon key is safe for the browser (RLS-guarded).

VITE_API_BASE=http://localhost:4000       # Railway API URL in production
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=                    # public anon key (NOT the service role key)
VITE_AMPLITUDE_API_KEY=                    # Amplitude web project key
