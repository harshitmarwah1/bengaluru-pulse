# Bengaluru Pulse - server / ingestion env (copy to .env; never commit real values).
# Adapters auto-detect mode: a key present => live adapter; absent => stub adapter.

PORT=4000

# --- Supabase (Project Settings -> API) -------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=        # server-only; bypasses RLS. NEVER ship to clients.

# --- Feed: traffic (pick one provider) --------------------------------------
GOOGLE_MAPS_API_KEY=              # Google Maps Platform (Distance Matrix / Roads)
# TOMTOM_API_KEY=
# HERE_API_KEY=

# --- Feed: rain -------------------------------------------------------------
KSNDMC_API_URL=                  # Karnataka rain gauges (needs state access/MoU)
KSNDMC_API_KEY=
IMD_API_KEY=                     # IMD nowcast (Mausam), optional secondary

# --- Feed: bus --------------------------------------------------------------
BMTC_GTFS_URL=                   # static GTFS zip URL
BMTC_GTFS_RT_URL=                # GTFS-realtime (needs BMTC ITS access), optional

# --- Feed: metro / flood / population (stub until keys/data exist) -----------
BMRCL_STATUS_URL=
FLOOD_SENSORS_URL=
POPULATION_DATASET_URL=

# --- Push (Expo) ------------------------------------------------------------
EXPO_ACCESS_TOKEN=               # optional; enables push receipts/higher limits

# --- Citizen channel (later) ------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Ingestion cadence ------------------------------------------------------
INGEST_INTERVAL_SECONDS=180
