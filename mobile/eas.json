{
  "cli": {
    "version": ">= 5.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "distribution": "store"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "$APPLE_ID",
        "appleIdPassword": "$APPLE_ID_PASSWORD",
        "ascAppId": "$ASC_APP_ID",
        "teamId": "$APPLE_TEAM_ID"
      },
      "android": {
        "serviceAccount": "$ANDROID_SERVICE_ACCOUNT",
        "track": "production"
      }
    }
  }
}
